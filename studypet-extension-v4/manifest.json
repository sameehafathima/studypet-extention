{
  "manifest_version": 3,
  "name": "StudyPet",
  "version": "4.0.0",
  "version_name": "4.0.0 Bloom",
  "description": "Adorable study companion: Pomodoro + site blocker + pet evolution + heatmap + per-site time tracker + Lo-Fi beats + break mini-game + AI chatter.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "scripting",
    "notifications",
    "declarativeNetRequest",
    "offscreen",
    "contextMenus",
    "idle"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "css": ["pet-overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-focus": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Start or stop a focus session"
    },
    "toggle-pet": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Show or hide the on-page pet"
    },
    "open-minigame": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Open the bubble-pop break mini-game"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pet-overlay.css",
        "blocked.html",
        "newtab.html",
        "minigame.html",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
